# Enterprise integration placeholders. Supply values through a secret manager.
UPUB_DOMAIN=upub.example.org
UPUB_API_KEY=replace-with-rotated-service-boundary-key
ORTHANC_PASSWORD=replace-with-rotated-orthanc-password
OIDC_ISSUER_URL=https://identity.example.org/realms/research
OIDC_CLIENT_ID=upub-edge
OIDC_CLIENT_SECRET=inject-from-secret-manager
SIEM_HTTPS_ENDPOINT=https://siem.example.org/ingest/upub
TLS_CERT_PATH=/run/secrets/upub.crt
TLS_KEY_PATH=/run/secrets/upub.key
